OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
SITE_URL=https://your-app.example.com
SITE_NAME=CineTot
CINETOT_DB=data/learner.sqlite3
CINETOT_CONTENT_DB=data/content.sqlite3
STUDIO_TOKEN=pick-something-random
# LOG_LEVEL=DEBUG and LOG_PROMPTS=1 print full prompts and replies to stdout.
LOG_LEVEL=INFO
LOG_PROMPTS=0
# PROBE_AUTOMATICALLY=1 probes every accepted draft. Costs ~9 extra calls each,
# which free tiers rate-limit hard, so it is off by default.
PROBE_AUTOMATICALLY=0
